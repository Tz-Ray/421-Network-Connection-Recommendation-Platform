rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profile documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Connections stored per user:
    // users/{uid}/connections/{connectionId}
    match /users/{userId}/connections/{connectionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Latest ranking vote per (search, candidate); read back to reorder AI Rerank results.
    match /users/{userId}/rankingFeedback/{voteId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['candidateId', 'queryKey', 'feedback', 'updatedAt'])
        && request.resource.data.candidateId is string
        && request.resource.data.candidateId.matches('^[0-9a-f]{64}$')
        && request.resource.data.queryKey is string
        && request.resource.data.queryKey.matches('^[0-9a-f]{64}$')
        && voteId == request.resource.data.queryKey + '_' + request.resource.data.candidateId
        && request.resource.data.feedback in ['relevant', 'irrelevant']
        && request.resource.data.updatedAt == request.time;
    }

    // Ranking feedback telemetry: append-only, own docs only, never readable by clients.
    match /ranking_telemetry/{eventId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['userId', 'candidateId', 'queryText', 'feedback', 'timestamp'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.candidateId is string
        && request.resource.data.candidateId.matches('^[0-9a-f]{64}$')
        && request.resource.data.queryText is string
        && request.resource.data.queryText.size() <= 500
        && request.resource.data.feedback in ['relevant', 'irrelevant']
        && request.resource.data.timestamp == request.time;
    }

    // Shared "common connections" graph (opt-in). graph_people/{personKey} holds only the
    // uids of members who have that person (personKey = sha256 of the normalized LinkedIn
    // profile URL); no names or other person data. A member can only read a node they are
    // recorded in, and can only add or remove their own uid.
    function isGraphMember() {
      return existsAfter(/databases/$(database)/documents/graph_members/$(request.auth.uid));
    }

    match /graph_people/{personKey} {
      allow get, list: if request.auth != null
        && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && personKey.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['members', 'updatedAt'])
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.updatedAt == request.time
        && isGraphMember();
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 10000
        && request.resource.data.members.toSet().difference(resource.data.members.toSet()).hasOnly([request.auth.uid])
        && resource.data.members.toSet().difference(request.resource.data.members.toSet()).hasOnly([request.auth.uid])
        && (request.auth.uid in resource.data.members || request.auth.uid in request.resource.data.members)
        && (!(request.auth.uid in request.resource.data.members)
            || request.auth.uid in resource.data.members
            || isGraphMember());
      allow delete: if false;
    }

    // Opt-in flag + display name for the common-connections graph. Readable only by
    // signed-in users who opted in themselves; never listable.
    match /graph_members/{memberId} {
      allow get: if request.auth != null
        && (request.auth.uid == memberId
            || exists(/databases/$(database)/documents/graph_members/$(request.auth.uid)));
      allow list: if false;
      allow create, update: if request.auth != null && request.auth.uid == memberId
        && request.resource.data.keys().hasOnly(['displayName', 'updatedAt'])
        && request.resource.data.keys().hasAll(['displayName', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == memberId;
    }

    // Saved searches (Recommender criteria + strict flag under a title): owner-only,
    // create / read / delete, no update.
    match /users/{userId}/savedSearches/{searchId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['title', 'criteria', 'strictTitleOnly', 'createdAt'])
        && request.resource.data.keys().hasAll(['title', 'criteria', 'strictTitleOnly', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 80
        && request.resource.data.criteria is string
        && request.resource.data.criteria.size() >= 1
        && request.resource.data.criteria.size() <= 500
        && request.resource.data.strictTitleOnly is bool
        && request.resource.data.createdAt == request.time;
    }

    // Favorite connections ("Saved Connections"), keyed by the ranking-feedback candidateId:
    // owner-only, create / read / delete, no update.
    match /users/{userId}/favorites/{candidateId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && candidateId.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['name', 'position', 'company', 'url', 'savedAt'])
        && request.resource.data.keys().hasAll(['name', 'position', 'company', 'url', 'savedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.position is string
        && request.resource.data.position.size() <= 300
        && request.resource.data.company is string
        && request.resource.data.company.size() <= 200
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 500
        && request.resource.data.savedAt == request.time;
    }

    // Default deny everything else (keeps scope tight)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}