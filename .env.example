# Copy this file to .env.local (gitignored), fill in the values, and never commit .env.local.
# Vite and the AI proxy in server/ both read .env.local and .env from the repository root; .env.local wins.

# --- Firebase web app config (browser) ---
# From the Firebase console: Project settings > Your apps > Web app. Read by firebase.ts; ships in the bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: passed to initializeApp, but the app does not load Firebase Analytics.
# VITE_FIREBASE_MEASUREMENT_ID=

# --- Frontend -> AI proxy URL (browser) ---
# Base URL of the AI proxy; the dev server falls back to http://localhost:8787 when it is unset.
# Production builds refuse localhost: override it in the shell with a public URL or `off` (AI switched off).
VITE_AI_PROXY_URL=http://localhost:8787

# --- AI proxy Gemini settings (server-only; never give these a VITE_ prefix) ---
# Gemini API key from Google AI Studio; read only by server/index.js.
GEMINI_API_KEY=
# Model for every AI call (a leading "models/" is stripped); unset means gemini-1.5-flash.
GEMINI_MODEL=gemini-2.5-flash
# Used when the primary model fails or runs out of daily quota (quotas are per model); unset = no fallback.
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Thinking budget for 2.5+/3.x models; 0 stops thinking tokens from using up the 1400-token output cap.
# GEMINI_THINKING_BUDGET=0

# --- Optional proxy settings (server-only) ---
# Proxy port; anything that is not an integer from 1 to 65535 falls back to 8787.
# AI_PROXY_PORT=8787
# Firebase project whose ID tokens the proxy accepts; unset means VITE_FIREBASE_PROJECT_ID.
# FIREBASE_PROJECT_ID=
# Comma-separated CORS allowlist; setting it replaces this default list.
# AI_PROXY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://connectionrecommender.web.app,https://connectionrecommender.firebaseapp.com
# Requests per signed-in user per sliding minute and per UTC day (positive integers).
# AI_RATE_LIMIT_PER_MIN=10
# AI_RATE_LIMIT_PER_DAY=40
# Tests only: set GEMINI_MOCK=1 in the shell (canned replies, no Gemini calls), never here; see server/README.md.
